{
  "name": "dripy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "demo:register": "node --env-file-if-exists=.env.local --import tsx scripts/demo-register.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/photon-worker.ts",
    "test": "tsx scripts/test-buycheck.ts && tsx scripts/test-unit.ts",
    "test:contract": "tsx scripts/contract-test.ts",
    "gmail:auth": "node --env-file-if-exists=.env.local --import tsx scripts/gmail-auth.ts",
    "test:integrations": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/test-integrations.ts",
    "smoke:gemini": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/smoke-gemini.ts",
    "smoke:stripe": "node --env-file-if-exists=.env.local --import tsx scripts/smoke-stripe.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "spectrum-ts": "^12.11.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
