# Copy to .env.local and fill in. Anything left blank falls back to a labeled mock/simulation.

# --- Gemini (agent brain + vision + receipt parsing). Key: https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Supabase (service role: server-side only, never ship to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- SerpAPI (Google Lens + Google Shopping) ---
SERPAPI_KEY=
# true = curated demo matches when vision sees a demo garment (deterministic demo); false = always live SerpAPI
DEMO_CATALOG=true

# --- Photon (iMessage bridge worker: npm run worker) ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
# shared secret between the worker and /api/messages/inbound (any long random string)
PHOTON_WORKER_SECRET=
# where the worker reaches the backend, and where the backend reaches the worker's /health
DRIPY_BACKEND_URL=http://localhost:3000
PHOTON_WORKER_URL=http://localhost:8787
# demo phone number in E.164; messages from it map to the demo user
DEMO_USER_PHONE=

# --- Payments ---
# simulated (default, zero setup) | stripe (real Stripe TEST-mode charge on a Visa test card)
# | visa_sandbox (Visa Intelligent Commerce, needs the VISA_* credentials below)
PAYMENT_PROVIDER=simulated
# From a Stripe SANDBOX: Developers -> API keys. Prefer a restricted key (rk_test_...) with
# Customers, PaymentMethods, PaymentIntents = Write. Live keys (sk_live_/rk_live_) are refused.
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` (local) or the webhook endpoint you add in the dashboard
STRIPE_WEBHOOK_SECRET=

# Visa Intelligent Commerce sandbox (only for PAYMENT_PROVIDER=visa_sandbox)
VISA_BASE_URL=https://apitest.visaacceptance.com
VISA_MERCHANT_ID=
VISA_SHARED_SECRET_KEY_ID=
VISA_SHARED_SECRET=
VISA_TOKEN_REQUESTER_ID=
VISA_RELATIONSHIP_ID=
VISA_INSTRUMENT_IDENTIFIER_ID=
VISA_CUSTOMER_ID=

# --- Guardrails ---
PURCHASE_CAP_CENTS=30000
APPROVAL_TTL_MINUTES=10
# MERCHANT_ALLOWLIST=zara.com,hm.com,asos.com,nordstrom.com,ssense.com,uniqlo.com,levi.com,mango.com,cos.com,everlane.com

# --- Fallback switches: none | all | csv of llm,db,serpapi,overpass,payments,photon,tiktok,mock ---
FORCE_FALLBACK=

# --- Demo defaults (UW campus) ---
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_LAT=47.6553
DEMO_LNG=-122.3035
